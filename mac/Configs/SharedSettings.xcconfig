// SharedSettings.xcconfig
//
// Tracked baseline build configuration: ad-hoc signing, so anyone can build
// without an Apple Developer account. Override locally (signing team etc.) in
// mac/Configs/DeveloperSettings.xcconfig (gitignored); `#include?` is optional.

DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -

// Must be the LAST line so its values win over the defaults above.
#include? "DeveloperSettings.xcconfig"
