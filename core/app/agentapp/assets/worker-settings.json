{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(npm publish:*)",
      "Bash(cargo publish:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(rm -rf:*)",
      "Read(./.env*)",
      "Edit(./.env*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "mcp__pixie__close_session"
    ],
    "deny": ["AskUserQuestion"],
    "allow": ["mcp__pixie", "mcp__mascot"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:{{PORT}}/hooks/stop",
            "timeout": 5,
            "headers": { "Authorization": "Bearer $PIXIE_AGENT_TOKEN" },
            "allowedEnvVars": ["PIXIE_AGENT_TOKEN"]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:{{PORT}}/hooks/permission",
            "timeout": 125,
            "headers": { "Authorization": "Bearer $PIXIE_AGENT_TOKEN" },
            "allowedEnvVars": ["PIXIE_AGENT_TOKEN"]
          }
        ]
      }
    ]
  }
}
